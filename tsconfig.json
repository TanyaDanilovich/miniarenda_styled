{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
  ],
  "compilerOptions": {
    "types": [
      "styled-components",
      "node"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ],
    // Если есть кастомные типы
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "verbatimModuleSyntax": true,
  },
  "include": ["src"]
}
