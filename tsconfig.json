{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ],
  "compilerOptions": {
    "types": [
      "styled-components",
      "node"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ],
    // Если есть кастомные типы
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": true,
//    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/**/*"
  ]
}
